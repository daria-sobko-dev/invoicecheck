# Copy this file to .env and fill in the values: cp .env.example .env
# Never commit .env: it contains secrets.

# Gemini API key (required for the agents).
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# PostgreSQL connection (required). With docker-compose.yml as is, use:
# postgresql://invoicecheck:invoicecheck@localhost:5432/invoicecheck
DATABASE_URL=

# Redis connection for the BullMQ job queue (required). With docker-compose.yml as is, use:
# redis://localhost:6379
REDIS_URL=

# Langfuse tracing (optional). Leave all three empty to run without tracing.
# Create a project at https://cloud.langfuse.com, then Settings -> API Keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# For example https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_BASE_URL=

# Key for the tRPC API (required for npm run api and npm run client).
# Make up any long random string, for example: openssl rand -hex 32
API_KEY=

# Queue name (optional, default "invoices"). Tests use "invoices-test" (see vitest.config.ts).
# Keep it commented out: an empty value would mean an empty queue name.
# QUEUE_NAME=invoices
